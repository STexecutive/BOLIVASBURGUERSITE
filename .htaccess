# =========================================================
# Bolivas Burguer Artesanal — configuracoes do servidor
# Hostinger (Apache). Este arquivo deve ficar dentro de public_html
# =========================================================

# ---------- Pagina de erro personalizada ----------
ErrorDocument 404 /404.html

RewriteEngine On

# ---------- Forca HTTPS (SOMENTE para conexoes desecriptadas) ----------
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ---------- Redireciona sem-www para www (SOMENTE se for HTTP_HOST sem www) ----------
RewriteCond %{HTTP_HOST} ^bolivasburguer\.com\.br$ [NC]
RewriteRule ^(.*)$ https://www.bolivasburguer.com.br$1 [R=301,L]

# ---------- Nao redireciona recursos (CSS, JS, imagens, etc) ----------
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ---------- Serve index.html para URLs sem arquivo ---
RewriteRule ^([^.]+)$ index.html [L]

# ---------- Compactacao (deixa o site mais leve) ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------- Cache do navegador ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp        "access plus 1 year"
  ExpiresByType image/jpeg        "access plus 1 year"
  ExpiresByType image/png         "access plus 1 year"
  ExpiresByType text/css          "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/html         "access plus 1 hour"
</IfModule>

# ---------- Prevenir cache agressivo de recursos dinâmicos ----------
<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=3600" "expr=%{CONTENT_TYPE} == 'text/html'"
  Header set Cache-Control "public, max-age=604800" "expr=%{CONTENT_TYPE} == 'text/css'"
  Header set Cache-Control "public, max-age=604800" "expr=%{CONTENT_TYPE} == 'application/javascript'"
  Header set Cache-Control "public, max-age=31536000" "expr=%{CONTENT_TYPE} =~ m:image:"
</IfModule>

# ---------- Tipos MIME corretos ----------
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType text/css .css
  AddType application/javascript .js
  AddCharset UTF-8 .css .js .html
</IfModule>

# ---------- Seguranca basica ----------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-XSS-Protection "1; mode=block"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# Impede listagem de pastas
Options -Indexes
